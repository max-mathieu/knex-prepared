# Database Configuration for Integration Tests and Benchmarks
# Copy this file to .env and update with your database credentials

# Database host (default: localhost)
DB_HOST=localhost

# Database port (default: 5432)
DB_PORT=5432

# Database user (default: postgres)
DB_USER=postgres

# Database password (default: postgres)
DB_PASSWORD=postgres

# Database name (default: knex_prepared_test)
DB_NAME=knex_prepared_test

# Benchmark iterations (default: 1000)
# Higher values give more accurate results but take longer
BENCHMARK_ITERATIONS=1000
